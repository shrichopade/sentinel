## Database Schema

### Core Tables

```sql
-- Documents table
CREATE TABLE documents (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID NOT NULL,
  filename TEXT NOT NULL,
  source TEXT, -- 'upload' | 'google_drive'
  domain TEXT, -- 'subscription' | 'employment' | 'tax' | 'gdpr' | 'housing' | 'insurance'
  doc_type TEXT, -- 'contract' | 'policy' | 'correspondence' | 'receipt'
  vendor_name TEXT,
  effective_date DATE,
  expiry_date DATE,
  jurisdiction TEXT, -- 'GB' | 'US' | 'EU'
  risk_score INTEGER, -- 0-10
  status TEXT, -- 'processing' | 'active' | 'expired' | 'actioned'
  raw_text TEXT,
  created_at TIMESTAMP DEFAULT NOW()
);

-- Chunks table (for RAG)
CREATE TABLE chunks (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  document_id UUID REFERENCES documents(id) ON DELETE CASCADE,
  content TEXT NOT NULL,
  embedding vector(1024), -- Voyage voyage-4-large dimension
  chunk_index INTEGER,
  metadata JSONB,
  created_at TIMESTAMP DEFAULT NOW()
);

-- Obligations table
CREATE TABLE obligations (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  document_id UUID REFERENCES documents(id) ON DELETE CASCADE,
  obligation_type TEXT, -- 'renewal' | 'cancellation_window' | 'payment' | 'notice'
  due_date DATE,
  description TEXT,
  status TEXT, -- 'pending' | 'completed' | 'missed'
  financial_amount DECIMAL(10,2),
  currency TEXT DEFAULT 'GBP'
);

-- Actions table (HITL queue)
CREATE TABLE actions (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  document_id UUID REFERENCES documents(id) ON DELETE CASCADE,
  action_type TEXT, -- 'cancel' | 'negotiate' | 'complain' | 'gdpr_sar' | 'dispute'
  severity TEXT, -- 'low' | 'medium' | 'high' | 'critical'
  title TEXT NOT NULL,
  summary TEXT,
  draft_content TEXT,
  status TEXT DEFAULT 'pending', -- 'pending' | 'approved' | 'rejected' | 'sent'
  reasoning TEXT, -- agent's explanation
  sources JSONB, -- cited chunks
  created_at TIMESTAMP DEFAULT NOW(),
  actioned_at TIMESTAMP
);

-- Memory table
CREATE TABLE memory (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID NOT NULL,
  memory_type TEXT, -- 'vendor' | 'preference' | 'outcome'
  key TEXT NOT NULL,
  value JSONB,
  embedding vector(1536),
  created_at TIMESTAMP DEFAULT NOW(),
  updated_at TIMESTAMP DEFAULT NOW()
);

-- Regulatory knowledge base
CREATE TABLE regulatory_chunks (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  regulation_name TEXT, -- 'Consumer Rights Act 2015'
  jurisdiction TEXT, -- 'GB' | 'EU'
  section TEXT,
  content TEXT,
  embedding vector(1536),
  metadata JSONB,
  created_at TIMESTAMP DEFAULT NOW()
);

-- pgvector similarity search function
CREATE OR REPLACE FUNCTION match_chunks(
  query_embedding vector(1536),
  match_threshold float,
  match_count int,
  filter_doc_ids uuid[] DEFAULT NULL
)
RETURNS TABLE (
  id uuid,
  document_id uuid,
  content text,
  chunk_index int,
  metadata jsonb,
  similarity float
)
LANGUAGE plpgsql
AS $$
BEGIN
  RETURN QUERY
  SELECT
    chunks.id,
    chunks.document_id,
    chunks.content,
    chunks.chunk_index,
    chunks.metadata,
    1 - (chunks.embedding <=> query_embedding) AS similarity
  FROM chunks
  WHERE 
    (filter_doc_ids IS NULL OR chunks.document_id = ANY(filter_doc_ids))
    AND 1 - (chunks.embedding <=> query_embedding) > match_threshold
  ORDER BY chunks.embedding <=> query_embedding
  LIMIT match_count;
END;
$$;
```

