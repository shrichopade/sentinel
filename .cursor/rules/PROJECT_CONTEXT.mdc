## Agent Orchestration Pattern

### The Agentic Loop (Core Pattern)

```python
async def orchestrate(trigger: dict, user_id: str) -> dict:
    """
    Main orchestrator - delegates to sub-agents via tool use.
    This is the most important pattern in the system.
    """
    working_memory = {
        "trigger": trigger,
        "steps": [],
        "findings": []
    }
    
    messages = [build_initial_prompt(trigger, user_id)]
    
    while True:
        response = claude.messages.create(
            model="claude-sonnet-4-6",
            tools=ORCHESTRATOR_TOOLS,  # Sub-agents exposed as tools
            messages=messages
        )
        
        if response.stop_reason == "end_turn":
            break
            
        if response.stop_reason == "tool_use":
            # Extract tool calls from response
            tool_calls = extract_tool_calls(response)
            
            # Execute each sub-agent
            tool_results = await execute_tool_calls(
                tool_calls, 
                working_memory, 
                user_id
            )
            
            # Append results back to conversation
            messages = append_tool_results(messages, response, tool_results)
            working_memory["steps"].append(tool_calls)
        
        # Safety limit
        if len(messages) > 20:
            break
    
    return working_memory
```

