## RAG Implementation Pattern

### Document Ingestion Pipeline

```python
async def ingest_document(file_path: str, user_id: str) -> dict:
    """
    Sequential pipeline: extract → classify → chunk → embed → store
    """
    # 1. Extract raw text
    raw_text = extract_text(file_path)  # PyMuPDF
    
    # 2. Classify document (Claude call #1 - structured output)
    metadata = await classify_document(raw_text)
    # Returns: domain, doc_type, vendor_name, dates, summary
    
    # 3. Chunk document (hybrid: fixed 512 tokens + semantic boundaries)
    chunks = chunk_document(raw_text, metadata)
    
    # 4. Embed chunks (text-embedding-3-small)
    embeddings = await embed_chunks(chunks)
    
    # 5. Store document and chunks
    doc_id = await store_document(metadata, raw_text, user_id)
    await store_chunks(doc_id, chunks, embeddings)
    
    # 6. Extract obligations (Claude call #2 - structured output)
    obligations = await extract_obligations(raw_text, metadata)
    await store_obligations(doc_id, obligations)
    
    return {
        "doc_id": doc_id,
        "metadata": metadata,
        "obligations": obligations
    }
```

### Hybrid Retrieval

```python
async def retrieve(query: str, user_id: str, filters: dict = {}) -> list:
    """
    Combine semantic search + keyword search for robust retrieval
    """
    # Semantic search via pgvector
    query_embedding = await embed(query)
    semantic_results = await supabase.rpc('match_chunks', {
        'query_embedding': query_embedding,
        'match_threshold': 0.7,
        'match_count': 10,
        'filter': filters  # domain, doc_type, date_range
    })
    
    # Keyword fallback (important for dates, amounts, names)
    keyword_results = await supabase.from_('chunks') \
        .text_search('content', query) \
        .limit(5)
    
    # Rerank combined results
    return rerank(semantic_results + keyword_results, query)
```

